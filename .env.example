AWS_REGION=us-east-1

# S3 job I/O bucket. Pick one whose name contains "sagemaker" — the SageMaker
# execution role's S3 grant is scoped to *sagemaker* buckets; anything else
# needs an extra inline policy on the role.
RAG_S3_BUCKET=your-sagemaker-bucket

SM_EXECUTION_ROLE=arn:aws:iam::<account-id>:role/service-role/<sagemaker-exec-role>

# "local" reads artifacts/ ; "s3" pulls from s3://$RAG_S3_BUCKET/<prefix>/output/
RAG_INDEX_SOURCE=local
